# Database
DATABASE=postgresql+asyncpg://user:pass@localhost:5432/dbname

# Telegram bot token
BOT=

# Bot mode: webhook | polling
BOT_MODE=webhook

# Caddy domain — required for production (no scheme). Empty/missing defaults to localhost.
DOMAIN=tgflood.space

# Webhook (required when BOT_MODE=webhook)
WEBHOOK_HOST=https://bot.example.com
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=change_me_long_random
WEBHOOK_PORT=8080

# GitHub version: create a Release (tag v1.0.0) — bot shows that tag
GITHUB_REPO=SnimanOff/Flood-bot
GITHUB_BRANCH=master
GITHUB_TOKEN=

# Telegram user id auto-promoted to ROOT
ROOT_ID=
